<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="OpenIGI.Game.Igi2.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- How I.G.I. 2 draws: its terrain, sky, water, forest, HUD and first-person view, over the title-agnostic passes.
         The game itself is ProjectIGI.Game.Igi2, which knows nothing of this; only an app composition root names both. -->
    <ProjectReference Include="..\..\Core\ProjectIGI.Core\ProjectIGI.Core.csproj" />
    <ProjectReference Include="..\..\Engine\ProjectIGI.Engine\ProjectIGI.Engine.csproj" />
    <ProjectReference Include="..\..\Core\ProjectIGI.Formats\ProjectIGI.Formats.csproj" />
    <ProjectReference Include="..\ProjectIGI.Game\ProjectIGI.Game.csproj" />
    <ProjectReference Include="..\ProjectIGI.Game.Igi2\ProjectIGI.Game.Igi2.csproj" />
    <ProjectReference Include="..\..\Rendering\ProjectIGI.Rendering\ProjectIGI.Rendering.csproj" />
    <ProjectReference Include="..\ProjectIGI.Presentation\ProjectIGI.Presentation.csproj" />
    <!-- The retail menu shell (RetailMenuHost) is Project I.G.I.'s own; I.G.I. 2 draws its menus through it
         rather than a copy. There is no cycle: Presentation.Igi1 names no Igi2 project. -->
    <ProjectReference Include="..\ProjectIGI.Presentation.Igi1\ProjectIGI.Presentation.Igi1.csproj" />
  </ItemGroup>

</Project>
